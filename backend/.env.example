# Copy to backend/.env and adjust. Every value is optional.

# Where scans and the SQLite DB live (default: <project>/data)
# REVDROID_DATA_DIR=../data
# Where install_tools.py put apktool/jadx (default: <project>/tools)
# REVDROID_TOOLS_DIR=../tools

# Explicit tool paths (leave blank to auto-detect tools/ and PATH)
APKTOOL_PATH=
JADX_PATH=
JAVA_PATH=java

# Upload limit
MAX_UPLOAD_MB=150

# Tool limits. jadx is the step that breaks on big apps:
#   OutOfMemoryError -> raise JADX_HEAP (4g, 6g)
#   timeout          -> raise JADX_TIMEOUT_SEC
APKTOOL_TIMEOUT_SEC=180
JADX_TIMEOUT_SEC=600
JADX_HEAP=2g
JADX_THREADS=4
MAX_CONCURRENT_SCANS=2

# false = delete decompiled sources after each scan (saves a lot of disk)
KEEP_DECOMPILED=false
# true = also scan bundled libraries (androidx, okhttp, ...). Much noisier.
SCAN_LIBRARY_CODE=false
# Delete scans older than N days at startup (0 = keep forever)
SCAN_RETENTION_DAYS=30

CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
